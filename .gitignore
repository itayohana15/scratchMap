# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.test-dist

# QA/debug runtime captures (CAPTURE_FIXTURES=1) — dev-only diagnostic
# output, never committed. Canonical, hand-promoted regression fixtures
# stay under /fixtures (intentionally NOT ignored) — a capture only
# becomes a fixture by deliberately copying it there, never automatically.
/.qa-artifacts

# next.js
/.next/
/.next-corrupt-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
