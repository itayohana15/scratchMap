# Supabase (required — see supabase/migrations/0001_init.sql for schema setup)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (used for AI country recommendations — free tier key from ai.google.dev)
GEMINI_API_KEY=

# Reserved for later phases — not used yet.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Google Maps Platform Routes API (server-only — NEVER prefix with
# NEXT_PUBLIC_, never expose to the browser). Real inter-activity/inter-stay
# travel times use this when set; without it, the app falls back to an
# explicitly-labeled heuristic estimate (see src/lib/server/travel-routing.ts).
# Setup: in Google Cloud Console, enable "Routes API" on your project,
# attach a billing account (required by Google, even within any free
# monthly credit), create an API key restricted to the Routes API, and set
# it here.
GOOGLE_MAPS_API_KEY=
